# All optional. Missing values degrade gracefully (template comments, hidden leaderboard).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 排行榜：SUPABASE_URL + 任一 key 即可展示榜单；提交需要 SUPABASE_SERVICE_ROLE_KEY（只放服务端，别加 NEXT_PUBLIC_ 前缀）。
# 只配 anon key = 榜单只读，结果页不显示"上榜"，POST /api/board 返回 503。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 未设置时回退到 https://kline-replay.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/christopher47634/kline-replay
# 设为 1 才开放 /dev/motion 动效实验页（线上不要开）
NEXT_PUBLIC_DEV_PAGES=
